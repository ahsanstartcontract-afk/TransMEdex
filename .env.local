# TransMEdex Local Environment Variables
# Copy this file to '.env' inside the apps/api/ folder, or use it as a reference for your production environment variables.

# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Email Configuration (SMTP)
# Replace these with your actual email provider details for the contact form to work
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=465
SMTP_USER=contact@transmedex.org
SMTP_PASS=your_secure_password
MAIL_TO=destination@transmedex.org
